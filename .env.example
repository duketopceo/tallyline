# ── Core ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tallyline
API_PORT=4000
# Public base URL of this API — used in the GitHub App manifest
API_BASE_URL=http://localhost:4000
# Required in production — signs short-lived access JWTs. With
# NODE_ENV=production the API refuses to start if this is unset, empty,
# <32 chars or a known default: `openssl rand -hex 32`
JWT_SECRET=
# Authenticated requests per minute per token/session (0 disables)
RATE_LIMIT_PER_MIN=600
# Unauthenticated requests (+ failed credentials) per client IP, counted
# before auth; needs TRUSTED_PROXY=1 behind a proxy so IPs differ
#RATE_LIMIT_ANON_PER_MIN=120
# login / bootstrap / invite-accept / OAuth start+callback per client IP
#RATE_LIMIT_AUTH_PER_MIN=30
# ms a dispatch may sit unacknowledged (`queued`) before it fails loudly
# on the issue thread. Keep above the ~7.5 min webhook retry budget. 0 = off
#DISPATCH_ACK_TIMEOUT_MS=600000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── GitHub App (issue sync / PR linking) ─────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# also enables "Sign in with GitHub" when SECRET is set
# (the App's OAuth client credentials double as the provider's)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Auth & SSO ───────────────────────────────────────
# Public web origin — OAuth callbacks land here
WEB_URL=http://localhost:3100
# AES-256-GCM key for provider client_secrets stored in the DB —
# `openssl rand -base64 32`. Losing/rotating it makes existing
# DB-stored secrets undecryptable (re-enter them in settings)
AUTH_SECRET_KEY=
# Comma-separated emails that are instance admins (provider CRUD).
# When unset, the bootstrap workspace owner is the fallback admin
AUTH_ADMIN_EMAILS=
# 1 = hide password login (SSO-only installs)
#AUTH_DISABLE_PASSWORD=
# auto | login | disabled — when a provider sign-in matches an
# existing verified email, link the identity silently / require
# a pending-link proof / never link
#AUTH_ACCOUNT_LINKING=auto
# Comma-separated domains allowed to create accounts via OAuth
# (empty = any domain). Workspace invites bypass this
#AUTH_ALLOWED_EMAIL_DOMAINS=
# Default OFF (was on): 1 lets a brand-new OAuth user auto-join the
# workspace when the instance has exactly one. WARNING — on
# internet-facing installs this is open membership
#AUTH_AUTO_JOIN_SINGLE_WORKSPACE=1
# Default OFF: only instance admins can create workspaces. 1 = any
# signed-in human can
#TALLYLINE_ALLOW_WORKSPACE_CREATE=1
# Default OFF: webhook / agent-dispatch URLs that resolve to private,
# loopback, link-local, CGNAT, ULA or metadata addresses are rejected
# (SSRF guard). 1 = allow, for self-hosters delivering to LAN services
#TALLYLINE_WEBHOOK_ALLOW_PRIVATE=1
# Sentry webhook client secret; Sentry deliveries are refused when it is
# empty (GlitchTip does not sign and needs nothing here)
SENTRY_SIGNING_SECRET=
# 1 = trust CF-Connecting-IP, then the last X-Forwarded-For hop (rate
# limits) and X-Forwarded-Proto (HSTS/Secure) — set only behind
# Cloudflare or a real reverse proxy (spoofable otherwise)
#TRUSTED_PROXY=1

# ── OAuth providers ──────────────────────────────────
# Any provider left empty is simply absent from the login page.
# Env-configured providers shadow DB rows of the same key and
# can't be edited in settings — see docs/auth.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generic OIDC — discovery via ${OIDC_ISSUER}/.well-known/…
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=
# space-separated, always includes `openid`
OIDC_SCOPES=email profile

# ── Slack (notifications / commands) ─────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
# tallyline workspace the app reports into (self-host binding)
SLACK_WORKSPACE_SLUG=
# reaction that drafts an issue from a thread
SLACK_INTAKE_EMOJI=ticket

# ── Third-party integrations ─────────────────────────
COMPOSIO_API_KEY=
LINEAR_API_KEY=

# ── LLM assist (opt-in; empty = all surfaces off) ────
# OpenRouter or any OpenAI-compatible /chat/completions endpoint
TALLYLINE_LLM_API_KEY=
TALLYLINE_LLM_BASE_URL=https://openrouter.ai/api/v1
TALLYLINE_LLM_MODEL=nvidia/nemotron-3.5-lightning
# OpenRouter-only fallback chain after the model (comma list; "none" = off)
TALLYLINE_LLM_FALLBACKS=google/gemma-4-26b-a4b-it,deepseek/deepseek-v4-flash

# ── Self-host only (docker-compose.selfhost.yml) ─────
# Required there — password for the internal postgres
POSTGRES_PASSWORD=
#POSTGRES_USER=postgres
#POSTGRES_DB=tallyline   # name kept so existing volumes keep working
# host ports the services bind
#WEB_PUBLISH_PORT=3100
#API_PUBLISH_PORT=4000
# server-side API origin inside the compose network — already
# set to http://api:4000 in the compose file; override only for
# exotic topologies
#API_INTERNAL_URL=http://api:4000

# ── Backups (ops/backup.sh — read by the script, not the app) ─────
# age PUBLIC key (age1...) — keep the private key off this host
#BACKUP_AGE_RECIPIENT=
#BACKUP_PG_CONTAINER=
#BACKUP_S3_BUCKET=
#BACKUP_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#BACKUP_HEALTHCHECK_URL=
