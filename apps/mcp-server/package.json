{
  "name": "@tallyline/mcp-server",
  "version": "2.0.0",
  "description": "Tallyline MCP server: issue tracker tools for AI agents (stdio and Streamable HTTP)",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "issue-tracker",
    "agents",
    "tallyline"
  ],
  "type": "module",
  "bin": {
    "tallyline-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --external:@modelcontextprotocol/sdk --external:zod && esbuild src/lib.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/lib/lib.js --external:@modelcontextprotocol/sdk --external:zod",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --no-file-parallelism",
    "prepack": "pnpm build",
    "prebuild": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "esbuild": "^0.25.0",
    "@tallyline/types": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duketopceo/tallyline.git",
    "directory": "apps/mcp-server"
  },
  "homepage": "https://github.com/duketopceo/tallyline#readme",
  "bugs": {
    "url": "https://github.com/duketopceo/tallyline/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./lib": {
      "types": "./dist/lib/lib.d.ts",
      "default": "./dist/lib/lib.js"
    }
  }
}
