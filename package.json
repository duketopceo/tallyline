{
  "name": "tallyline",
  "license": "AGPL-3.0-only",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "lint:design": "pnpm --filter @tallyline/silver-lining run lint:design",
    "test:contrast": "pnpm --filter @tallyline/silver-lining run test:contrast",
    "test:token-parity": "pnpm --filter @tallyline/silver-lining run test:token-parity",
    "check": "turbo run typecheck lint && turbo run test --concurrency=1",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "^2.4.0",
      "fast-uri": "^3.1.9",
      "ip-address": "^10.7.4",
      "lodash": "^4.18.0",
      "uuid@<11.1.1": "^11.1.1",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0"
    }
  }
}
