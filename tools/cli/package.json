{
  "name": "@tallyline/cli",
  "version": "2.0.0",
  "description": "Tallyline CLI: work the issue board from the terminal or an agent",
  "keywords": [
    "cli",
    "issue-tracker",
    "agents",
    "tallyline"
  ],
  "type": "module",
  "bin": {
    "tallyline": "./dist/index.js",
    "tly": "./dist/index.js",
    "dok": "./dist/dok.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts src/dok.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prepack": "pnpm build",
    "prebuild": "rm -rf dist"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@tallyline/mcp-server": "workspace:*",
    "@tallyline/types": "workspace:*",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duketopceo/tallyline.git",
    "directory": "tools/cli"
  },
  "homepage": "https://github.com/duketopceo/tallyline#readme",
  "bugs": {
    "url": "https://github.com/duketopceo/tallyline/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
